# ====================================================================
# PROMPT ARABIC - VERCEL & NEON POSTGRES ENVIRONMENT VARIABLES
# ====================================================================

# 1. Neon Postgres Database URL (Automatically generated when linking Neon via Vercel Marketplace)
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# 2. Vercel Blob Storage Token (Automatically generated when linking Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# 3. Auth Secret Key for HttpOnly Admin Session Cookie
AUTH_SECRET=your-random-32-character-secret-key-here

# 4. Production Domain / Site URL (Used for generating SSR OpenGraph and share URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
